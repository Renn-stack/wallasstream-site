{
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "rewrites": [
    { "source": "/connect", "destination": "/connect.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/help", "destination": "/help.html" },
    { "source": "/legal", "destination": "/legal.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/es", "destination": "/indexES.html" },
    { "source": "/contacto", "destination": "/contactES.html" },
    { "source": "/preguntas", "destination": "/faqES.html" },
    { "source": "/ayuda", "destination": "/helpES.html" },
    { "source": "/aviso-legal", "destination": "/legalES.html" },
    { "source": "/descargar", "destination": "/downloadES.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/connect.html", "destination": "/connect", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/faq.html", "destination": "/faq", "permanent": true },
    { "source": "/help.html", "destination": "/help", "permanent": true },
    { "source": "/legal.html", "destination": "/legal", "permanent": true },
    { "source": "/download.html", "destination": "/download", "permanent": true },
    { "source": "/indexES.html", "destination": "/es", "permanent": true },
    { "source": "/contactES.html", "destination": "/contacto", "permanent": true },
    { "source": "/faqES.html", "destination": "/preguntas", "permanent": true },
    { "source": "/helpES.html", "destination": "/ayuda", "permanent": true },
    { "source": "/legalES.html", "destination": "/aviso-legal", "permanent": true },
    { "source": "/downloadES.html", "destination": "/descargar", "permanent": true }
  ]
}
