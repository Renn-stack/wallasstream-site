{
  "name": "wallasstream-site",
  "version": "1.0.0",
  "private": true,
  "description": "Wallas' Stream marketing site. Static HTML; the only build step expands shared HTML partials.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dist": "node build.mjs --dist",
    "check": "node build.mjs --check",
    "dev": "wrangler dev",
    "deploy": "npm run build:dist && wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
